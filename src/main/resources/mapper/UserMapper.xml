<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.redture.campus.mapper.UserMapper">

    <select id="selectByStudentNo" resultType="cn.redture.campus.pojo.entity.User">
        SELECT *
        FROM users
        WHERE student_no = #{studentNo}
        LIMIT 1
    </select>

    <select id="selectIdsByStudentNos" resultType="long">
        SELECT id
        FROM users
        WHERE student_no IN
        <foreach collection="studentNos" item="studentNo" open="(" separator="," close=")">
            #{studentNo}
        </foreach>
    </select>
</mapper>
