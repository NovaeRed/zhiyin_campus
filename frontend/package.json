{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "format": "prettier --write src index.html vite.config.ts eslint.config.js \"*.json\" .prettierrc.json",
    "format:check": "prettier --check src index.html vite.config.ts eslint.config.js \"*.json\" .prettierrc.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:ui:live": "node scripts/verify-ui.mjs --live"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "axios": "^1.20.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^17.6.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.3.5",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.0.0"
  }
}
